# ==============================================================================
# LinuxOps Production Environment Variables Template (.env.production.example)
# ==============================================================================
# Copy this file to '.env.production' on your production host or configure these
# variables in your cloud provider's Secrets Manager / Environment Settings.
#
# CRITICAL SECURITY REQUIREMENTS:
# 1. NEVER commit real production secrets, credentials, or keys to Git.
# 2. LinuxOps enforces 'fail-closed' authentication: missing credentials block access.
# 3. All real container mutations are disabled by default (LINUXOPS_RECOVERY_DISABLED=1).
# ==============================================================================

# --- Network & Server Binding ---
# Platform-assigned port (e.g., Render sets $PORT dynamically; default is 8501)
PORT=8501

# Production interface binding (0.0.0.0 inside isolated containers; 127.0.0.1 behind Nginx VPS)
BIND_ADDRESS=0.0.0.0

# --- Authentication & Role-Based Access Control (RBAC) ---
# MUST be set to 'production' for public or internet-facing deployments.
# In 'production' mode, local dev login forms are completely disabled.
LINUXOPS_AUTH_MODE=production

# Comma-separated list of exact email addresses granted the Administrator role.
# In production, role assignment is strictly whitelist-based. Unlisted emails receive read-only Viewer access.
# Email prefixes (e.g. admin-attacker@evil.com) are NEVER granted Admin privileges in production.
LINUXOPS_ADMIN_USERS=admin@yourcompany.com,devops-lead@yourcompany.com

# --- Streamlit OpenID Connect (OIDC) Credentials ---
# In production, create '.streamlit/secrets.toml' (chmod 0600) or configure in your secrets manager:
#
# [auth]
# redirect_uri = "https://linuxops.yourdomain.com/oauth2callback"
# cookie_secret = "REPLACE_WITH_RANDOM_64_CHAR_HEX_KEY"
# client_id = "REPLACE_WITH_GOOGLE_OR_ENTRA_OAUTH_CLIENT_ID"
# client_secret = "REPLACE_WITH_GOOGLE_OR_ENTRA_OAUTH_CLIENT_SECRET"
# server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
# admin_users = "admin@yourcompany.com,devops-lead@yourcompany.com"

# --- Host Monitoring Agent HMAC Secret ---
# Shared preshared secret between LinuxOps central dashboard and remote telemetry agents.
# Agents use this to sign payloads via HMAC-SHA256. Unsigned or tampered payloads are rejected.
# Mandatory in production mode.
LINUXOPS_AGENT_SECRET=REPLACE_WITH_64_CHAR_CRYPTOGRAPHIC_HMAC_SECRET

# --- Configured Monitored Remote Hosts ---
# Comma-separated list of registered hosts in format: host_id:Host Display Name
LINUXOPS_MONITORED_HOSTS=node-east-1:Production East Node,node-west-1:Production West Node

# --- Safety Kill-Switch ---
# In production, real-host mutations must remain disabled. Keep set to '1'.
# Live Host Monitoring remains strictly read-only.
# Remediation actions in Simulation Lab remain strictly simulated in-memory.
LINUXOPS_RECOVERY_DISABLED=1

# --- Host Monitoring Alert Thresholds (Percentages 0.0 - 100.0) ---
CPU_WARNING=70.0
CPU_CRITICAL=90.0

MEMORY_WARNING=80.0
MEMORY_CRITICAL=90.0

DISK_WARNING=80.0
DISK_CRITICAL=90.0
