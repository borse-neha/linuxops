# ==============================================================================
# LINUXOPS CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================
# Copy to '.env' for local operational adjustments.
# NOTE: The '.env' file is strictly excluded in .gitignore.
# SECURITY NOTICE: No real credentials, secrets, tokens, or private keys belong here.
# ==============================================================================

# --- Authentication & Access Control (RBAC) ---
# Modes:
#   'local_dev'  : Interactive local session login for development / testing.
#   'production' : Strictly enforces OpenID Connect (OIDC) authentication.
LINUXOPS_AUTH_MODE=local_dev

# Comma-separated list of user emails authorized for Administrator role
# Admins can approve and simulate remediation, toggle the freeze switch, and configure hosts.
# All other authenticated users are assigned the read-only 'Viewer' role.
LINUXOPS_ADMIN_USERS=admin@company.com,operator@company.com

# --- Streamlit OpenID Connect (OIDC) Secrets Guidance ---
# For production OIDC, create '.streamlit/secrets.toml' (never commit to git):
# [auth]
# redirect_uri = "https://linuxops.yourdomain.com/oauth2callback"
# cookie_secret = "REPLACE_WITH_RANDOM_LONG_STRING"
# client_id = "REPLACE_WITH_OAUTH_CLIENT_ID"
# client_secret = "REPLACE_WITH_OAUTH_CLIENT_SECRET"
# server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
# admin_users = "admin@company.com,lead@company.com"

# --- Secure Remote Host Monitoring Configuration ---
# Comma-separated list of remote hosts in format: host_id:Host Display Name
LINUXOPS_MONITORED_HOSTS=node-east-1:Production East Node,node-west-1:Production West Node

# Preshared HMAC-SHA256 secret for validating telemetry pushed by scripts/linuxops_agent.py
LINUXOPS_AGENT_SECRET=REPLACE_WITH_64_CHAR_HEX_OR_RANDOM_SECRET

# --- Host Monitoring Resource Thresholds (Percentages 0.0 - 100.0) ---
CPU_WARNING=70.0
CPU_CRITICAL=90.0

MEMORY_WARNING=80.0
MEMORY_CRITICAL=90.0

DISK_WARNING=80.0
DISK_CRITICAL=90.0

# --- Recovery Controller Safety Kill-Switch ---
# Set to '1', 'true', or 'yes' to unconditionally disable all container recoveries
# Default is '0' (recommendation-only / dry-run mode active by default)
LINUXOPS_RECOVERY_DISABLED=0
